  m_Name: 
  m_EditorClassIdentifier: TRACE.Runtime::TRACE.Narrative.StoryDirector
  squad: {fileID: 953158247}
  encounter: {fileID: 294062811}
  dialogue: {fileID: 658394508}
  ambience: {fileID: 1189801870}
  clueTerminal: {fileID: 1245486061}
  badge: {fileID: 106389209}
  clueDoor: {fileID: 1528269769}
  eventDoor: {fileID: 538366888}
  arenaGates:
  - {fileID: 372544003}
  - {fileID: 460794198}
  - {fileID: 1040756312}
  eventLight: {fileID: 1707912024}
  eventScreen: {fileID: 65120400}
  tensionLights:
  - {fileID: 818038001}
  - {fileID: 1608035051}
  - {fileID: 214202889}
  conclusionLight: {fileID: 1771204077}
  conclusionScreen: {fileID: 259552361}
  conclusionScreenOn: {fileID: 2100000, guid: 7098567e4b1576b4f981245d625ff3fa, type: 2}
  hallZone: {fileID: 976382269}
  tensionZone: {fileID: 1562153201}
  arenaZone: {fileID: 1266797033}
  zoneRadius: 5
  arrivalDelay: 4
  conclusionDelay: 1.5
  eventScreenDuration: 3
  tensionLightIntensity: 4
  arenaGateRadius: 7
  arrivalLines:
  - speaker: CONTROL
    text: "Pas un bruit. M\xEAme pas les machines."
    duration: 3
  - speaker: ASSAULT
    text: On avance. Ouvrez l'oeil.
    duration: 2.6
  clueLines:
  - speaker: TERMINAL
    text: ARCHIVE ENTRY // INCOMPLETE
    duration: 2.4
  - speaker: TERMINAL
    text: 'Occupancy records: 143'
    duration: 2.4
  - speaker: TERMINAL
    text: 'Registered residents: 0'
    duration: 2.8
  - speaker: ASSAULT
    text: "\xC7a ne colle pas."
    duration: 2.2
  - speaker: CONTROL
    text: Quoi ?
    duration: 1.6
  - speaker: ASSAULT
    text: "Le b\xE2timent. Il est trop grand pour les plans."
    duration: 3.2
  - speaker: SUPPORT
    text: "...Je pensais \xEAtre la seule \xE0 l'avoir remarqu\xE9."
    duration: 3.4
  badgeLines:
  - speaker: SUPPORT
    text: "Un badge d'acc\xE8s. OKAFOR, maintenance. Valid\xE9 il y a trois jours."
    duration: 3.6
  - speaker: CONTROL
    text: "Trois jours. Le site est ferm\xE9 depuis dix ans."
    duration: 3.2
  eventLines:
  - speaker: CONTROL
    text: Quelqu'un vient d'ouvrir cette porte.
    duration: 2.8
  - speaker: SUPPORT
    text: "Il n'y a personne d'enregistr\xE9 ici."
    duration: 2.8
  - speaker: ASSAULT
    text: "Alors on va voir qui n'est pas enregistr\xE9."
    duration: 3
  tensionLines:
  - speaker: ASSAULT
    text: "Restez group\xE9s. Ils arrivent."
    duration: 2.6
  - speaker: CONTROL
    text: Tab pour lire, molette pour verrouiller. On se couvre.
    duration: 3.2
  conclusionLines:
  - speaker: TERMINAL
    text: IDENTITY MATCH FOUND
    duration: 2.6
  - speaker: TERMINAL
    text: 'STATUS: DECEASED'
    duration: 2.6
  - speaker: TERMINAL
    text: 'LAST ACCESS: 12 MINUTES AGO'
    duration: 3.2
  - speaker: SUPPORT
    text: ...Douze minutes.
    duration: 2.4
  - speaker: ASSAULT
    text: On n'est pas seuls ici.
    duration: 3
