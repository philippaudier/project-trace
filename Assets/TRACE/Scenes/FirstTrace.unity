  m_Script: {fileID: 11500000, guid: 797f0a08f9684ec3bb11e36cde71af80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TRACE.Runtime::TRACE.Narrative.StoryDirector
  squad: {fileID: 953158247}
  encounter: {fileID: 294062811}
  dialogue: {fileID: 91060828}
  ambience: {fileID: 1675768669}
  clueTerminal: {fileID: 1318757937}
  badge: {fileID: 1750929543}
  clueDoor: {fileID: 1115009686}
  eventDoor: {fileID: 2029989464}
  arenaGates:
  - {fileID: 260872990}
  - {fileID: 471166321}
  - {fileID: 1085228019}
  eventLight: {fileID: 259080680}
  eventScreen: {fileID: 1675851435}
  tensionLights:
  - {fileID: 2024994953}
  - {fileID: 397138756}
  - {fileID: 1099083796}
  conclusionLight: {fileID: 243604348}
  conclusionScreen: {fileID: 1738289538}
  conclusionScreenOn: {fileID: 2100000, guid: 7098567e4b1576b4f981245d625ff3fa, type: 2}
  hallZone: {fileID: 1879126077}
  tensionZone: {fileID: 529528935}
  arenaZone: {fileID: 503566404}
  zoneRadius: 5
  arrivalDelay: 4
  conclusionDelay: 1.5
  eventScreenDuration: 3
  tensionLightIntensity: 4
  arenaGateRadius: 7
  arrivalLines:
  - speaker: CONTROL
    text: "Pas un bruit. M\xEAme pas les machines."
    duration: 3
  - speaker: ASSAULT
    text: On avance. Ouvrez l'oeil.
    duration: 2.6
  clueLines:
  - speaker: TERMINAL
    text: ARCHIVE ENTRY // INCOMPLETE
    duration: 2.4
  - speaker: TERMINAL
    text: 'Occupancy records: 143'
    duration: 2.4
  - speaker: TERMINAL
    text: 'Registered residents: 0'
    duration: 2.8
  - speaker: ASSAULT
    text: "\xC7a ne colle pas."
    duration: 2.2
  - speaker: CONTROL
    text: Quoi ?
    duration: 1.6
  - speaker: ASSAULT
    text: "Le b\xE2timent. Il est trop grand pour les plans."
    duration: 3.2
  - speaker: SUPPORT
    text: "...Je pensais \xEAtre la seule \xE0 l'avoir remarqu\xE9."
    duration: 3.4
  badgeLines:
  - speaker: SUPPORT
    text: "Un badge d'acc\xE8s. OKAFOR, maintenance. Valid\xE9 il y a trois jours."
    duration: 3.6
  - speaker: CONTROL
    text: "Trois jours. Le site est ferm\xE9 depuis dix ans."
    duration: 3.2
  eventLines:
  - speaker: CONTROL
    text: Quelqu'un vient d'ouvrir cette porte.
    duration: 2.8
  - speaker: SUPPORT
    text: "Il n'y a personne d'enregistr\xE9 ici."
    duration: 2.8
  - speaker: ASSAULT
    text: "Alors on va voir qui n'est pas enregistr\xE9."
    duration: 3
  tensionLines:
  - speaker: ASSAULT
    text: "Restez group\xE9s. Ils arrivent."
    duration: 2.6
  - speaker: CONTROL
    text: Tab pour lire, molette pour verrouiller. On se couvre.
    duration: 3.2
  conclusionLines:
  - speaker: TERMINAL
    text: IDENTITY MATCH FOUND
    duration: 2.6
  - speaker: TERMINAL
    text: 'STATUS: DECEASED'
    duration: 2.6
  - speaker: TERMINAL
    text: 'LAST ACCESS: 12 MINUTES AGO'
    duration: 3.2
  - speaker: SUPPORT
    text: ...Douze minutes.
    duration: 2.4
  - speaker: ASSAULT
    text: On n'est pas seuls ici.
    duration: 3
